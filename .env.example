# Copy to .env (gitignored) and fill in.

# Supabase Postgres for the kaze-master-in project, via the *session pooler*
# (Dashboard -> Connect -> Session pooler). The direct db.<ref>.supabase.co host
# is IPv6-only, which many home connections can't reach.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Optional — only for `npm test` server tests: a *local* Postgres the suite may
# create a database and throwaway schemas in. Never point this at Supabase.
# TEST_DATABASE_URL=postgres://postgres:<pw>@localhost:5432/daybook_test

# Optional — defaults shown.
# PORT=3000
# PUBLIC_ORIGIN=https://<machine-name>.<tailnet-name>.ts.net
